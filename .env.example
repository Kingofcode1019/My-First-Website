# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Web SDK configuration. These values are public and are bundled into
# the browser by Vite; they are identifiers, not service-account credentials.
# Keep the client and Admin database IDs pointed at the same Firestore database.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-only Firebase Admin credentials. Never prefix these with VITE_ and
# never expose them to browser code. Paste the service-account private key with
# escaped \n characters; src/lib/firebase/admin.ts converts them to newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_ID=

# The Firebase Auth UID of the initial platform owner. This is never accepted
# from the browser and should only be configured in server/Vercel environments.
PLATFORM_OWNER_UID=

# Google OAuth web application. Register this exact callback URL in Google Cloud
# Console as an authorized redirect URI, enable the Google Sheets API, and add
# the app URL to the OAuth consent screen's authorized origins.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
