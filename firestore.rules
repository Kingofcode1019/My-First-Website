rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Platform/admin data is server-managed through Firebase Admin SDK.
    // It is intentionally inaccessible to browser clients, including admins.
    match /platform/{document=**} {
      allow read, write: if false;
    }

    // A user can access only their own root document and business collections.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(settingId);
      }

      match /products/{productId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(productId);
      }

      match /inventoryMovements/{movementId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(movementId);
      }

      match /customers/{customerId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(customerId);
      }

      match /orders/{orderId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(orderId);
      }

      match /suppliers/{supplierId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(supplierId);
      }

      match /purchases/{purchaseId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(purchaseId);
      }

      match /accounts/{accountId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(accountId);
      }

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(transactionId);
      }

      match /journalEntries/{entryId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(entryId);
      }

      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(expenseId);
      }

      match /financeCategories/{categoryId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(categoryId);
      }

      match /financeAuditLogs/{auditId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(auditId);
        allow update, delete: if false;
      }
    }
  }
}
